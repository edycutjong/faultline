# Faultline configuration.
#
# The app runs with NONE of these set: the landing page and the recorded example hunt render
# without credentials, which is what a cold visit to the deploy must survive. They are needed
# only to dispatch live hunts.
#
# Provision them with `scripts/provision.sh` (see README) once the Nebius tenant can create
# resources.

# --- Nebius service account: signs the JWT that is exchanged for a Bearer token -----------
# Created with `nebius iam service-account create`, then
# `nebius iam auth-public-key create --account-service-account-id <id> --data "$(cat public.pem)"`
NEBIUS_SERVICE_ACCOUNT_ID=serviceaccount-e00...
NEBIUS_AUTH_KEY_ID=publickey-e00...

# The PEM contents of the RSA private key. Vercel env vars cannot hold literal newlines, so
# store it with escaped \n and the app will unescape it:
#   awk 'NF {sub(/\r/,""); printf "%s\\n", $0;}' private.pem
NEBIUS_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIJ...\n-----END PRIVATE KEY-----\n"

# --- Where jobs run -----------------------------------------------------------------------
NEBIUS_PROJECT_ID=project-e00...
NEBIUS_SUBNET_ID=vpcsubnet-e00...
# eu-north1 is the only region carrying both cpu-e2 and gpu-l40s-a.
NEBIUS_REGION=eu-north1

# --- Object Storage: the channel a probe's verdict travels ---------------------------------
# Access keys are a SEPARATE credential from the authorized key above:
#   nebius iam v2 access-key create --account-service-account-id <id>
NEBIUS_BUCKET=faultline
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
# Defaults to https://storage.<region>.nebius.cloud
# NEBIUS_S3_ENDPOINT=

# --- Container images ----------------------------------------------------------------------
# Built from probe/ and narration/ and pushed to a registry the Nebius project can pull from.
FAULTLINE_PROBE_IMAGE=ghcr.io/<owner>/faultline-probe:v1
FAULTLINE_NARRATION_IMAGE=ghcr.io/<owner>/faultline-narration:v1

# --- Optional -------------------------------------------------------------------------------
# Unauthenticated GitHub allows 60 requests/hour per IP, which a handful of judges hitting the
# deploy at once would exhaust. A read-only token raises it to 5000. Public repos only, so no
# scopes are required.
# GITHUB_TOKEN=
