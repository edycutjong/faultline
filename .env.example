# Faultline configuration. Placeholders only — never put a real value in this file.
#
# The app runs with NONE of these set: the landing page and the recorded example hunt render
# without credentials, which is what a cold visit to the deploy must survive. They are needed
# only to dispatch live hunts.
#
# `scripts/provision.sh` creates the service account, its authorized key, the bucket and the
# access key with the Nebius CLI, and prints the Nebius block below filled in.

# --- Nebius service account: signs the JWT that is exchanged for a Bearer token -------------
NEBIUS_SERVICE_ACCOUNT_ID=serviceaccount-e00...
NEBIUS_AUTH_KEY_ID=publickey-e00...

# The PEM contents of the RSA private key. Vercel env vars cannot hold literal newlines, so
# store it with escaped \n and the app will unescape it:
#   awk 'NF {sub(/\r/,""); printf "%s\\n", $0;}' private.pem
NEBIUS_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIJ...\n-----END PRIVATE KEY-----\n"

# --- Where probe jobs run -------------------------------------------------------------------
# The home region: its project and subnet own the first probe slots, and the bucket lives here.
# eu-west1 carries the cpu-d3 platform the probes use. Defaults to eu-west1.
NEBIUS_PROJECT_ID=project-e01...
NEBIUS_SUBNET_ID=vpcsubnet-e01...
# NEBIUS_REGION=eu-west1

# More regions, as comma-separated region:project:subnet triples. Each adds
# FAULTLINE_SLOTS_PER_REGION concurrent probes (the deployed app runs four regions, 8 slots).
# FAULTLINE_EXTRA_REGIONS=uk-south1:project-e03...:vpcsubnet-e03...,me-west1:project-i00...:vpcsubnet-i00...

# Concurrent probe jobs per region. Defaults to 2, the measured compute.instance.count quota:
# a third concurrent job is rejected, not queued. Raise it only with a raised quota.
# FAULTLINE_SLOTS_PER_REGION=2

# The image every probe job runs. Defaults to the stock python:3.11; probe.py is injected into
# it per job, so no image has to be built or pushed.
# FAULTLINE_PROBE_IMAGE=python:3.11

# --- Object Storage: hunt records, coordination, and the verdicts probes PUT back -------------
# Access keys are a SEPARATE credential from the authorized key above:
#   nebius iam v2 access-key create --account-service-account-id <id>
NEBIUS_BUCKET=faultline
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
# Defaults to https://storage.<home region>.nebius.cloud
# NEBIUS_S3_ENDPOINT=

# --- Token Factory: the one root-cause paragraph per hunt -------------------------------------
# Without a key a hunt still names its culprit; the report says no explanation was generated.
TOKENFACTORY_API_KEY=
# TOKENFACTORY_PROJECT_ID=
# TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# FAULTLINE_NARRATION_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- The deployment -------------------------------------------------------------------------
# The public base URL probes POST their tick to. On Vercel production it is derived from
# VERCEL_PROJECT_PRODUCTION_URL; set it anywhere else a probe must reach the app.
# FAULTLINE_PUBLIC_URL=https://faultline.example.com

# Live hunts per UTC day (default 10; a value below 1 is ignored). The landing page shows the count.
# FAULTLINE_DAILY_CAP=10

# A code that starts a hunt past the daily cap. Unset means no bypass.
# FAULTLINE_BYPASS_CODE=

# Unauthenticated GitHub allows 60 requests/hour per IP, which a handful of visitors resolving
# ranges at once would exhaust. A read-only token raises it to 5000. Public repos only, so no
# scopes are required.
# GITHUB_TOKEN=
