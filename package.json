{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "description": "Parallel N-ary bisection of a broken commit range across Nebius Serverless AI Jobs.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run audit"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
